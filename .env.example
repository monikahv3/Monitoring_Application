# Local demo only — copy to .env and adjust. Never commit real secrets.
#   cp .env.example .env

# Flask session signing key (required for real use; demo default exists in code)
SECRET_KEY=replace-with-a-long-random-string

# Seeded admin account (used only when the DB has no admin row yet)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Optional SQLite path (default: monitoring.db)
# DATABASE=monitoring.db
